<?xml version="1.0" encoding="utf-8"?>
<!-- Big-wheel cart. 10 cm wide (X), 24 cm long (Y).
     Local z=0 is the table top surface (wheel contact plane).
     Wheel radius=0.022; platform sits at the wheel equator (z=0.022).
     An invisible collision pedestal (z=0..0.026) provides physical support. -->
<mujoco model="big_cart">
  <worldbody>
    <body name="base">

      <body name="object">
        <inertial pos="0 0 0.013" mass="0.5" diaginertia="0.0004 0.0012 0.0012"/>
        <site name="origin" pos="0 0 0" rgba="0 0 0 0" size="0.005"/>

        <!-- Invisible collision pedestal: spans z=0 (table surface) to z=0.026 (platform top) -->
        <geom name="truck_collision" pos="0 0 0.013" size="0.05 0.12 0.013" type="box"
          group="0" friction="1 0.005 0.0001" rgba="0 0 0 0"/>

        <!-- Visual platform: centred at wheel equator (z=0.022), thin slab -->
        <geom name="cart_body" pos="0 0 0.022" size="0.05 0.12 0.004" type="box"
          group="1" contype="0" conaffinity="0" rgba="0.70 0.70 0.70 1"/>

        <!-- Thin rim around the top edge of the platform -->
        <geom name="rim_left"  pos=" 0.051 0 0.029" size="0.001 0.121 0.003" type="box"
          group="1" contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"/>
        <geom name="rim_right" pos="-0.051 0 0.029" size="0.001 0.121 0.003" type="box"
          group="1" contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"/>
        <geom name="rim_front" pos="0  0.121 0.029" size="0.052 0.001 0.003" type="box"
          group="1" contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"/>
        <geom name="rim_rear"  pos="0 -0.121 0.029" size="0.052 0.001 0.003" type="box"
          group="1" contype="0" conaffinity="0" rgba="0.82 0.82 0.82 1"/>

        <!-- Wheels: visual-only. Radius=0.022, centre z=0.022 so bottom sits at z=0. -->
        <geom name="wheel_fl" fromto=" 0.050 0.090 0.022  0.062 0.090 0.022" size="0.022"
          type="cylinder" group="1" contype="0" conaffinity="0" rgba="0.4 0.4 0.4 1"/>
        <geom name="wheel_fr" fromto="-0.050 0.090 0.022 -0.062 0.090 0.022" size="0.022"
          type="cylinder" group="1" contype="0" conaffinity="0" rgba="0.4 0.4 0.4 1"/>
        <geom name="wheel_rl" fromto=" 0.050 -0.090 0.022  0.062 -0.090 0.022" size="0.022"
          type="cylinder" group="1" contype="0" conaffinity="0" rgba="0.4 0.4 0.4 1"/>
        <geom name="wheel_rr" fromto="-0.050 -0.090 0.022 -0.062 -0.090 0.022" size="0.022"
          type="cylinder" group="1" contype="0" conaffinity="0" rgba="0.4 0.4 0.4 1"/>

      </body>

      <site name="bottom_site"            pos="0 0 0"     rgba="0 0 0 0" size="0.005"/>
      <site name="top_site"               pos="0 0 0.026"  rgba="0 0 0 0" size="0.005"/>
      <site name="horizontal_radius_site" pos="0 0.12 0"  rgba="0 0 0 0" size="0.003"/>

    </body>
  </worldbody>
</mujoco>
