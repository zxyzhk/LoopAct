<?xml version="1.0" encoding="utf-8"?>
<!-- Red toy robot — simple design: head, body, arms, legs.
     Collision: single box matching HighBlock [0.05, 0.02, 0.089].
     Head: exactly 10 × 4 cm footprint. Facing -Y, origin at bottom.
     Physics: density=500 on collision geom (matches HighBlock BoxObject),
              density=0 on all visual geoms, no joint damping. -->

<mujoco model="toy_robot_red">
  <worldbody>
    <body name="base">

    <body name="object">
      <site name="origin" pos="0 0 0" rgba="0 0 0 0" size="0.005"/>

      <!-- === Collision: single box identical to HighBlock === -->
      <!-- density=500 → MuJoCo computes mass/inertia identically to BoxObject(density=500) -->
      <!-- solref/solimp explicitly match BoxObject defaults (same as MuJoCo defaults) -->
      <geom name="toybot_collision" pos="0 0 0.089" size="0.05 0.02 0.089" type="box"
        group="0" density="500" friction="2.0 0.01 0.001"
        solref="0.02 1.0" solimp="0.9 0.95 0.001" rgba="0 0 0 0"/>

      <!-- === Visuals (density=0 so they don't affect mass/inertia) === -->

      <!-- Head (10 × 4 cm, z 0.118 → 0.178) -->
      <geom name="head" pos="0 0 0.148" size="0.05 0.02 0.030" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.80 0.12 0.08 1"/>
      <!-- Visor panel (front -Y face) -->
      <geom name="visor" pos="0 -0.022 0.153" size="0.044 0.0018 0.013" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.10 0.10 0.16 0.85"/>
      <geom name="eye_l" pos=" 0.016 -0.024 0.155" size="0.006" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.95 0.95 0.95 1"/>
      <geom name="eye_r" pos="-0.016 -0.024 0.155" size="0.006" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.95 0.95 0.95 1"/>
      <geom name="pupil_l" pos=" 0.016 -0.027 0.155" size="0.004" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.05 0.05 0.05 1"/>
      <geom name="pupil_r" pos="-0.016 -0.027 0.155" size="0.004" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.05 0.05 0.05 1"/>
      <geom name="mouth" pos="0 -0.022 0.128" size="0.018 0.0018 0.0022" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.25 0.25 0.25 1"/>

      <!-- Body (z 0.028 → 0.118) -->
      <geom name="body" pos="0 0 0.073" size="0.044 0.018 0.045" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.85 0.15 0.10 1"/>
      <!-- Breast panel (front -Y face) -->
      <geom name="chest_plate" pos="0 -0.020 0.082" size="0.040 0.0018 0.022" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.60 0.60 0.66 1"/>
      <!-- Breast buttons -->
      <geom name="btn_blue"   pos=" 0.012 -0.022 0.090" size="0.004" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.10 0.35 0.92 1"/>
      <geom name="btn_white"  pos="-0.012 -0.022 0.090" size="0.004" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.92 0.92 0.92 1"/>
      <geom name="btn_orange" pos="0      -0.022 0.076" size="0.004" type="sphere"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.96 0.52 0.05 1"/>

      <!-- Arms + hands -->
      <geom name="arm_l" fromto="0.044 0 0.096 0.068 0 0.080" size="0.009"
        type="cylinder" group="1" contype="0" conaffinity="0" density="0" rgba="0.75 0.12 0.08 1"/>
      <geom name="hand_l" pos="0.074 0 0.076" size="0.008 0.012 0.012" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.22 0.22 0.26 1"/>

      <geom name="arm_r" fromto="-0.044 0 0.096 -0.068 0 0.080" size="0.009"
        type="cylinder" group="1" contype="0" conaffinity="0" density="0" rgba="0.75 0.12 0.08 1"/>
      <geom name="hand_r" pos="-0.074 0 0.076" size="0.008 0.012 0.012" type="box"
        group="1" contype="0" conaffinity="0" density="0" rgba="0.22 0.22 0.26 1"/>

      <!-- Legs -->
      <body name="leg_l_body" pos="0.018 0 0.028">
        <geom name="leg_l" fromto="0 0 0 0 0 -0.020" size="0.011"
          type="cylinder" group="1" contype="0" conaffinity="0" density="0" rgba="0.75 0.12 0.08 1"/>
        <geom name="foot_l" pos="0 -0.007 -0.026" size="0.014 0.018 0.007" type="box"
          group="1" contype="0" conaffinity="0" density="0" rgba="0.22 0.22 0.26 1"/>
      </body>

      <body name="leg_r_body" pos="-0.018 0 0.028">
        <geom name="leg_r" fromto="0 0 0 0 0 -0.020" size="0.011"
          type="cylinder" group="1" contype="0" conaffinity="0" density="0" rgba="0.75 0.12 0.08 1"/>
        <geom name="foot_r" pos="0 -0.007 -0.026" size="0.014 0.018 0.007" type="box"
          group="1" contype="0" conaffinity="0" density="0" rgba="0.22 0.22 0.26 1"/>
      </body>

    </body>

    <site name="bottom_site"            pos="0 0 0"     rgba="0 0 0 0" size="0.005"/>
    <site name="top_site"               pos="0 0 0.178"  rgba="0 0 0 0" size="0.005"/>
    <site name="horizontal_radius_site" pos="0.074 0 0" rgba="0 0 0 0" size="0.003"/>

    </body>
  </worldbody>
</mujoco>
