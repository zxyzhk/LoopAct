<?xml version="1.0" encoding="utf-8"?>
<!-- High block: same collision as toy_robot_red, visual starts at z=0.026 (cart platform height).
     Bottom 0.026m is transparent so the block appears to sit on the visual cart. -->

<mujoco model="high_block_red">
  <worldbody>
    <body name="base">

      <body name="object">
        <site name="origin" pos="0 0 0" rgba="0 0 0 0" size="0.005"/>

        <!-- Full-height collision (transparent, density=500) -->
        <geom name="block_collision" pos="0 0 0.099" size="0.05 0.02 0.099" type="box"
          group="0" density="500" friction="2.0 0.01 0.001"
          solref="0.02 1.0" solimp="0.9 0.95 0.001" rgba="0 0 0 0"/>

        <!-- Visual: red, z=0.018→0.198 (dips 8mm into cart platform to close any gap) -->
        <geom name="block_visual" pos="0 0 0.098" size="0.05 0.02 0.090" type="box"
          group="1" contype="0" conaffinity="0" density="0" rgba="0.85 0.15 0.10 1"/>

      </body>

      <site name="bottom_site"            pos="0 0 0"     rgba="0 0 0 0" size="0.005"/>
      <site name="top_site"               pos="0 0 0.198"  rgba="0 0 0 0" size="0.005"/>
      <site name="horizontal_radius_site" pos="0.05 0 0"  rgba="0 0 0 0" size="0.003"/>

    </body>
  </worldbody>
</mujoco>
