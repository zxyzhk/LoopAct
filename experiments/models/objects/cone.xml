<!--
  Cone: yellow tapered cylinder with one end smaller than the other.

  Built as a stack of cylinder slices along the local Z axis, with radius
  decreasing linearly from 0.028 (z = -0.065, "big end") to 0.018 (z = +0.065,
  "small end"). Total length 0.13 — same as the soda can.

  When laid on its side and placed on a slope, the unequal-radius ends roll
  unequal arcs per rotation, so the cone traces a circular arc rather than a
  straight line. The small end is the inner pivot of that arc.

  Following robosuite convention: each slice has a paired group="0" collision
  geom (transparent) and group="1" visual geom (no contacts).
-->
<mujoco model="cone">
  <worldbody>
    <body>
      <body name="object">
        <!-- Collision slices (group=0, transparent) -->
        <geom name="seg0_col" type="cylinder" size="0.0275 0.0065" pos="0 0 -0.0585"
              rgba="0.95 0.45 0.10 0.0" density="400" friction="0.8 0.01 0.001"
              solimp="0.99 0.999 0.001" solref="0.005 1" group="0" condim="3"/>
        <geom name="seg1_col" type="cylinder" size="0.0265 0.0065" pos="0 0 -0.0455"
