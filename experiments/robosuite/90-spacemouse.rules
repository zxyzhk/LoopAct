# udev rule for 3Dconnexion SpaceMouse devices
# This allows non-root users to access the SpaceMouse

# 3Dconnexion Universal Receiver (SpaceMouse Wireless)
SUBSYSTEM=="usb", ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c652", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", ATTRS{idProduct}=="c652", MODE="0666"

# Generic rule for all 3Dconnexion devices (vendor ID 256f)
SUBSYSTEM=="usb", ATTRS{idVendor}=="256f", MODE="0666"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="256f", MODE="0666"

